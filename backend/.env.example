# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model Names (Routed via OpenRouter)
MODEL_CHAT=qwen/qwen-2.5-32b-instruct
MODEL_PARSING=qwen/qwen-2.5-32b-instruct
MODEL_MATCHING=deepseek/deepseek-chat
MODEL_COVER_LETTER=deepseek/deepseek-chat

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=antigravity_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/antigravity_db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Application Settings
APP_ENV=development
APP_PORT=8000
